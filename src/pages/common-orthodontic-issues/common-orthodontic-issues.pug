.pages-inner
  Loader(v-show='loading')
  .content_part(v-if='props && !loading')
    Header()
    .innerpage-top(v-bind:style="{ backgroundImage: 'url('+ propspageheader.acf.innerpage_top_bg +')'}")
    .innerpage_content_wrap
      .container_manual.clearfix
        #content_left
          h1(v-if='props.title.rendered' v-html:span='props.title.rendered')
          .content_all
            .common_ortho_outer(v-if='props.acf.common_orthodontics_list')
              .common_ortho_list(v-for='CommonOrthoList in props.acf.common_orthodontics_list')
                h2(v-if='CommonOrthoList.title' v-html='CommonOrthoList.title')
                .box_ortho.clearfix
                  .before-after-box.clearfix
                    .before-after-image(v-if='CommonOrthoList.before_img')
                      img(alt='' v-bind:src='CommonOrthoList.before_img')
                      span Before
                    .before-after-image(v-if='CommonOrthoList.afteer_img')
                      img(alt='' v-bind:src='CommonOrthoList.afteer_img')
                      span After
                  .before-after-text(v-if='CommonOrthoList.description' v-html='CommonOrthoList.description')      
                hr       
        #content_right
          .hide-stock(v-if='props.better_featured_image')
            img(v-bind:src='props.better_featured_image.source_url')
          .subnav_menu
           h4(v-if='propspageheader.acf.submenu_title' v-html:span='propspageheader.acf.submenu_title')
           ul
              li
                router-link( to='/common-orthodontic-issues' v-bind:class="{ active: isActive }") 
                  span Common Orthodontic Issues
              li
                router-link( to='/surgical-orthodontics' v-bind:class="{ active: isActive }") 
                  span Surgical Orthodontics
              li
                router-link( to='/dentofacial-orthopedics' v-bind:class="{ active: isActive }") 
                  span Dentofacial Orthopedics
              li
                router-link( to='/incognito' v-bind:class="{ active: isActive }") 
                  span Incognito™
              li
                router-link( to='/clarity-advanced-ceramic-brackets' v-bind:class="{ active: isActive }") 
                  span Clarity™ Advanced Ceramic Brackets
              li
                router-link( to='/acceledent-aura' v-bind:class="{ active: isActive }") 
                  span AcceleDent® Aura
              li
                router-link( to='/damon-smile' v-bind:class="{ active: isActive }") 
                  span Damon™ Smile 
              li
                router-link( to='/damon-clear' v-bind:class="{ active: isActive }") 
                  span Damon™ Clear
              li
                router-link( to='/itero-element' v-bind:class="{ active: isActive }") 
                  span iTero® Element™
              li
                router-link( to='/tads' v-bind:class="{ active: isActive }") 
                  span TADs 
          
    Footer()        
      
