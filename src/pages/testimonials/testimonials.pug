.pages-inner
  Loader(v-show='loading')
  .content_part(v-if='props && !loading')
    Header()
    .innerpage-top(v-bind:style="{ backgroundImage: 'url('+ propspageheader.acf.innerpage_top_bg +')'}")
    .innerpage_content_wrap
      .container_manual.clearfix
        #content_left
          h1(v-if='props.title.rendered' v-html:span='props.title.rendered')
          .content_all
            .testimonial_intro(v-if='props.acf.testimonial_intro_content' v-html:span='props.acf.testimonial_intro_content')
            hr
            .testomonial_list_outer
              iframe(scrolling='yes' v-if='props.acf.testimonial_rating_iframe' v-bind:src='props.acf.testimonial_rating_iframe')
            hr
              
                
              
        #content_right
          .hide-stock(v-if='props.better_featured_image')
            img(v-bind:src='props.better_featured_image.source_url')
          .subnav_menu
           h4(v-if='propspageheader.acf.submenu_title' v-html:span='propspageheader.acf.submenu_title')
           ul
            li
              router-link( to='/office-visits' v-bind:class="{ active: isActive }") 
                span Office Visits
            li
              router-link( to='/financial-information' v-bind:class="{ active: isActive }") 
                span Financial Information
            li
              router-link( to='/testimonials' v-bind:class="{ active: isActive }") 
                span Testimonials
            li
              router-link( to='/before-and-after' v-bind:class="{ active: isActive }") 
                span Before and After 
            li
              router-link( to='/office-tour' v-bind:class="{ active: isActive }") 
                span Office Tour
            li
              router-link( to='/patient-forms' v-bind:class="{ active: isActive }") 
                span Patient Forms 
            li
              router-link( to='/smilechoice' v-bind:class="{ active: isActive }") 
                span Smile Choice                
          
    Footer()        
      
