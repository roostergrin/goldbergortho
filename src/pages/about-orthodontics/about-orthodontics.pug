.pages-inner
  Loader(v-show='loading')
  .content_part(v-if='props && !loading')
    Header()
    .innerpage-top(v-bind:style="{ backgroundImage: 'url('+ propspageheader.acf.innerpage_top_bg +')'}")
    .innerpage_content_wrap
      .container_manual.clearfix
        #content_left
          h1(v-if='props.title.rendered' v-html:span='props.title.rendered')
          .content_all(v-if='props.content.rendered' v-html:span='props.content.rendered')
        #content_right
          .hide-stock(v-if='props.better_featured_image')
            img(v-bind:src='props.better_featured_image.source_url')
          .subnav_menu
           h4(v-if='propspageheader.acf.submenu_title' v-html:span='propspageheader.acf.submenu_title')
           ul
             li
               router-link( to='/about-orthodontics' v-bind:class="{ active: isActive }") 
                 span About Orthodontics
             li
               router-link( to='/for-all-ages' v-bind:class="{ active: isActive }") 
                 span For All Ages
             li
               router-link( to='/two-phase-treatment' v-bind:class="{ active: isActive }") 
                 span Two-Phase Treatment
             li
               router-link( to='/brushing-and-flossing' v-bind:class="{ active: isActive }") 
                 span Brushing and Flossing
             li
               router-link( to='/itero-element' v-bind:class="{ active: isActive }") 
                 span iTero® Element™                  
          
    Footer()        
      
