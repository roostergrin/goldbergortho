.pages-inner
  Loader(v-show='loading')
  .content_part(v-if='props && !loading')
    Header()
    .innerpage-top(v-bind:style="{ backgroundImage: 'url('+ propspageheader.acf.innerpage_top_bg +')'}")
    .innerpage_content_wrap
      .container_manual.clearfix
        #content_left
          h1(v-if='props.title.rendered' v-html:span='props.title.rendered')
          .content_all
            .smilesnapcontent#content
              .page_content(v-if='props.content.rendered' v-html:span='props.content.rendered')
              .smilesnap-widget#smilesnap-expanded-container
        #content_right
          .hide-stock(v-if='props.better_featured_image')
            img(v-bind:src='props.better_featured_image.source_url')
          .subnav_menu
           h4(v-if='propspageheader.acf.submenu_title' v-html:span='propspageheader.acf.submenu_title')
           ul
              li
                router-link( to='/roslyn-office-location' v-bind:class="{ active: isActive }") 
                  span Roslyn Office Location
              li
                router-link( to='/appointment-request' v-bind:class="{ active: isActive }") 
                  span Appointment Request
              li
                a( href='https://www.goldbergortho.com/wp-content/uploads/2020/08/How-to-Photograph-Your-Smile-Flyer.pdf' v-bind:class="{ active: isActive }" target="_blank") 
                  span How to Photograph Your Smile
              li
                a( href='https://pplpractice-reviews.com/GolRoslyn' v-bind:class="{ active: isActive }") 
                  span Post-Appointment Survey 
          
    Footer()        
      
