.header(v-if='props')
  .top_bar(v-bind:style="{ backgroundImage: 'url('+ props.acf.top_bar_bg_img +')'}")
    .container_manual.clearfix
      .hd-right
        .hd-locations
          router-link.hd-address(v-if='props.acf.roslyn_location_url' v-bind:to='props.acf.roslyn_location_url')
            span(v-if='props.acf.roslyn_location_text' v-html:span='props.acf.roslyn_location_text')
          a(v-if='props.acf.phone_number' v-bind:href='"tel:" + props.acf.phone_number' itemprop='telephone')
            span.phone(v-if='props.acf.phone_number' v-html:span='props.acf.phone_number')
        .util-nav
          router-link.appt-req#forms(v-if='props.acf.forms_url' v-bind:to='props.acf.forms_url')
            span(v-if='props.acf.forms_text' v-html:span='props.acf.forms_text')
          router-link.appt-req(v-if='props.acf.complimentary_consultation_url' v-bind:to='props.acf.complimentary_consultation_url')
            span(v-if='props.acf.complimentary_consultation_text' v-html:span='props.acf.complimentary_consultation_text')
          a#patient-login.patient-login.external(:href='props.acf.patient_login_url' v-if='props.acf.patient_login_url')
            span(v-if='props.acf.patient_login_text' v-html:span='props.acf.patient_login_text')
        .social-icons(v-if='props.acf.social_bar_list')
          a.external(v-bind:href='SocialList.url' v-for='(SocialList, i) in props.acf.social_bar_list' target='_blank' :aria-label='"social-links-" + i')
            i.fa(v-bind:class='SocialList.icon')
  .header_menu
